# Production settings. Copy to .env.production on the server (never commit it) and use:
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Generate every secret below with:  python -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps them safe inside connection URLs). JWT_SECRET_KEY needs 64+ characters.

DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_USER=teamflow
POSTGRES_PASSWORD=
POSTGRES_DB=teamflow

REDIS_PASSWORD=

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_EXPIRE_HOURS=72
CACHE_TTL_SECONDS=60

# uvicorn worker processes (roughly one per CPU core).
WEB_CONCURRENCY=2
