# Copy to .env and fill in real values. Never commit .env.

# --- Postgres container (docker-compose) ---
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=teamflow
POSTGRES_PORT=5433

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://teamflow:change-me@127.0.0.1:5433/teamflow
TEST_DATABASE_URL=postgresql+psycopg://teamflow:change-me@127.0.0.1:5433/teamflow_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Must be true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false

# Invitations
INVITATION_EXPIRE_HOURS=72

# --- Redis (cache + rate limiting) ---
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/15
CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true

# --- Runtime tuning (optional; defaults shown) ---
# LOG_FORMAT=text                 # json in production (one object per line)
# DOCS_ENABLED=                   # unset = /docs on everywhere except production
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=15000
# WEB_CONCURRENCY=1               # uvicorn workers in Docker
